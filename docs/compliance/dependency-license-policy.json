      ]
    },
    {
      "id": "parse-cache-control-1.0.1-concluded-bsd-3-clause",
      "package": "parse-cache-control",
      "packagePath": "node_modules/parse-cache-control",
      "version": "1.0.1",
      "integrity": "sha512-60zvsJReQPX5/QP0Kzfd/VrpjScIQ7SHBW6bFCYfEP+fp0Eppr1SHhIO5nd1PjZtvclzSzES9D/p5nFJurwfWg==",
      "concludedLicense": "BSD-3-Clause",
