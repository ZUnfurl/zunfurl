# 由 gcss.project.json 派生。真实 secret 只写入本地 .env、平台 secret 或 GitHub Actions secrets。
SITE_PROFILE=cms-brand
SANITY_STUDIO_SITE_PROFILE=cms-brand
CONTENT_SOURCE=local
SITE_FEATURE_CONTACT_FORM=true

# Sanity 构建只读配置
SANITY_PROJECT_ID=
SANITY_DATASET=development
SANITY_API_VERSION=2026-06-20
SANITY_USE_CDN=true
SANITY_API_READ_TOKEN=

# Sanity Studio 公开构建配置
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=development
SANITY_STUDIO_HOST=gcss-demo-studio
SANITY_STUDIO_STOREFRONT_ORIGIN=https://example.com

# Sanity webhook -> Worker -> GitHub repository_dispatch
SANITY_WEBHOOK_SECRET=
GITHUB_DISPATCH_TOKEN=

# Contact 表单：Turnstile + Resend + Durable Object 原子限流
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
CONTACT_RECIPIENT_EMAIL=
RESEND_FROM_EMAIL=
CONTACT_HMAC_SECRET=
CONTACT_ALLOWED_ORIGINS=https://example.com
CONTACT_FORM_ENABLED=true

# GitHub Actions / Cloudflare 部署凭据
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
