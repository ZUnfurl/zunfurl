{
  "$schema": "./gcss.project.schema.json",
  "schemaVersion": 1,
  "frameworkVersion": "0.3.0-preview.1",
  "templateMode": true,
  "identity": {
    "projectName": "gcss-v3-site-framework",
    "brandName": "Example Brand",
    "domain": "example.com"
  },
  "delivery": {
    "profile": "cms-brand",
    "contentSource": "local",
    "defaultLocale": "en",
    "locales": [
      "en",
      "fr",
      "zh-cn"
    ]
  },
  "features": {
    "contactForm": true,
    "legalPages": [
      "privacy-policy",
      "terms-of-use",
      "customer-service-contact"
    ]
  },
  "deployment": {
    "workerName": "gcss-v3-site-framework",
    "studioHost": "gcss-demo-studio",
    "githubRepository": "owner/gcss-v3-site-framework"
  }
}
