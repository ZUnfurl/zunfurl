---
interface Block {
  id: string;
  eyebrow: string;
  title: string;
  body: string;
  items?: string[];
  variant: "standard" | "wide" | "accent";
}

interface Props {
  blocks: Block[];
}

const { blocks } = Astro.props;
---

<section class="section">
  <div class="container content-grid">
    {
      blocks.map((block, index) => (
        <article
          class={`surface-card content-grid__card content-grid__card--${block.variant}`}
          id={block.id}
          data-index={index + 1}
        >
          <div class="content-grid__header">
            <p class="eyebrow">{block.eyebrow}</p>
            <span class="content-grid__counter">0{index + 1}</span>
          </div>
          <h2 class="section-title">{block.title}</h2>
          <p class="body-copy">{block.body}</p>
          {block.items && block.items.length > 0 ? (
            <ul class="list-copy">
              {block.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          ) : null}
        </article>
      ))
    }
  </div>
</section>

<style>
  .content-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .content-grid__card {
    display: grid;
    gap: 1rem;
    align-content: start;
    min-height: 18rem;
    position: relative;
    overflow: hidden;
  }

  .content-grid__card::before {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-accent),
      transparent
    );
    opacity: 0.48;
  }

  .content-grid__header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
  }

  .content-grid__counter {
    font-size: 0.76rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    opacity: 0.75;
  }

  .content-grid__card--wide {
    grid-column: span 2;
  }

  .content-grid__card--accent {
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-surface) 80%, transparent),
        rgba(205, 169, 146, 0.18)
      ),
      color-mix(in srgb, var(--color-surface) 82%, transparent);
  }

  .content-grid__card--wide {
    min-height: 24rem;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: end;
  }

  .content-grid__card--wide > .section-title,
  .content-grid__card--wide > .body-copy {
    max-width: 30rem;
  }

  .content-grid__card--wide .list-copy {
    align-self: end;
    padding-left: 1rem;
    border-left: 1px solid var(--color-border);
  }

  @media (max-width: 980px) {
    .content-grid {
      grid-template-columns: 1fr;
    }

    .content-grid__card--wide {
      grid-column: span 1;
      grid-template-columns: 1fr;
    }
  }
</style>
