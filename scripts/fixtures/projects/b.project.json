{
  "$schema": "./gcss.project.schema.json",
  "schemaVersion": 1,
  "frameworkVersion": "0.3.0-preview.1",
  "templateMode": false,
  "identity": {
    "projectName": "northstar-brand-cms",
    "brandName": "Northstar CMS",
    "domain": "cms.northstar.test"
  },
  "delivery": {
    "profile": "cms-brand",
    "contentSource": "local",
    "defaultLocale": "en",
    "locales": [
      "en",
      "fr",
      "zh-cn"
    ]
  },
  "features": {
    "contactForm": false,
    "legalPages": [
      "privacy-policy",
      "terms-of-use",
      "customer-service-contact"
    ]
  },
  "deployment": {
    "workerName": "northstar-brand-cms",
    "studioHost": "northstar-brand-cms-studio",
    "githubRepository": "ZUnfurl/northstar-brand-cms"
  }
}
