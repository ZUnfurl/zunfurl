{
  "name": "gcss-v3-site-framework",
  "description": "ZUnfurl is a static-first foundation for brand sites and read-only retail catalogs.",
  "type": "module",
  "version": "0.3.0-preview.1",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZUnfurl/zunfurl.git"
  },
  "homepage": "https://github.com/ZUnfurl/zunfurl#readme",
  "bugs": {
    "url": "https://github.com/ZUnfurl/zunfurl/issues"
  },
  "keywords": [
    "astro",
    "sanity",
    "shopify",
    "cloudflare",
    "site-framework",
    "brand-site",
    "static-site"
  ],
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node ./scripts/storefront/run-with-env.mjs dev",
    "build": "node ./scripts/storefront/run-with-env.mjs build",
    "preview": "node ./scripts/storefront/run-with-env.mjs preview",
    "cf:dev": "node ./scripts/storefront/run-with-env.mjs build && npm --workspace gcss-worker run dev",
    "cf:deploy": "node ./scripts/storefront/run-with-env.mjs build && npm --workspace gcss-worker run deploy",
    "studio:dev": "node ./scripts/studio/run-with-env.mjs dev",
    "studio:build": "node ./scripts/studio/run-with-env.mjs build",
    "studio:deploy": "node ./scripts/studio/run-with-env.mjs deploy",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "test:sanity": "node ./scripts/tests/validate-sanity-migration-dry-run.mjs && node ./scripts/tests/validate-sanity-image-cdn-pilot.mjs && node ./scripts/tests/validate-site-image-source-boundaries.mjs && node ./scripts/tests/validate-product-draft.mjs && node ./scripts/tests/validate-product-launch-gate.mjs && node ./scripts/tests/validate-studio-product-launch-env.mjs && node ./scripts/tests/validate-product-workbench.mjs && node ./scripts/tests/validate-page-workbench.mjs && node ./scripts/tests/validate-product-locale-page-editor-structure.mjs && node ./scripts/tests/validate-page-editor-module-guides.mjs && node ./scripts/tests/validate-product-spotlight-card.mjs && node ./scripts/tests/validate-storefront-headless-structure.mjs",
    "test:commerce": "node ./scripts/tests/validate-commerce-contract.mjs",
    "test:shopify-summary": "node ./scripts/tests/validate-shopify-product-entry-summary.mjs",
    "test:worker": "node ./scripts/tests/validate-worker-routes.mjs && npm --workspace gcss-worker run test:runtime",
    "test:workflows": "node ./scripts/tests/validate-github-workflows.mjs",
    "test:template": "node ./scripts/tests/validate-template-tools.mjs && npm run test:project-config && npm run test:skill && npm run test:init",
    "test:project-config": "node ./scripts/tests/validate-project-config.mjs",
    "test:skill": "node ./scripts/tests/validate-framework-skill.mjs",
    "test:init": "node ./scripts/tests/validate-project-initializer.mjs",
    "test:matrix": "npm run test:fixtures",
    "test:fixtures": "node ./scripts/tests/validate-initialized-profile-fixtures.mjs",
    "test:profiles": "node ./scripts/tests/validate-site-profiles.mjs && node ./scripts/tests/validate-storefront-profile-routing.mjs && node ./scripts/tests/validate-studio-profile-tools.mjs && node ./scripts/tests/validate-studio-schema-profile.mjs && node ./scripts/tests/validate-customer-operations-guides.mjs",
    "test:profile-routing": "node ./scripts/tests/validate-storefront-profile-routing.mjs",
    "test:studio-profile": "node ./scripts/tests/validate-studio-profile-tools.mjs",
    "test:profile:static-brand": "node ./scripts/tests/validate-site-profiles.mjs --mode static-brand",
    "test:profile:cms-brand": "node ./scripts/tests/validate-site-profiles.mjs --mode cms-brand",
    "test:profile:retail": "node ./scripts/tests/validate-site-profiles.mjs --mode retail",
    "test:roadmap-recovery": "node ./scripts/tests/validate-backup-restore-dry-run.mjs",
    "test:capability-claims": "node ./scripts/tests/validate-public-capability-boundaries.mjs",
    "test:static-checks": "node ./scripts/tests/validate-static-check-contract.mjs",
    "test:content-encoding": "node ./scripts/tests/validate-content-encoding.mjs",
    "test:assets": "node ./scripts/tests/validate-public-assets.mjs",
    "test:public-text": "node ./scripts/tests/validate-public-text.mjs --current",
    "sbom:generate": "node ./scripts/compliance/generate-sbom.mjs --write",
    "sbom:check": "node ./scripts/compliance/generate-sbom.mjs --check",
    "test:licenses": "node ./scripts/compliance/validate-dependency-licenses.mjs",
    "test:repository-licenses": "node ./scripts/tests/validate-repository-license-coverage.mjs",
    "test:dependency-tree": "node ./scripts/tests/validate-dependency-tree.mjs",
    "test:supply-chain": "npm run test:dependency-tree && npm run sbom:check && npm run test:licenses",
    "test:phase1": "npm run test:content-encoding && npm run test:assets && npm run test:public-text",
    "test:phase4": "npm run test:supply-chain && npm run test:phase1 && npm run framework:audit && npm run typecheck && npm run test:fixtures",
    "test:version": "node ./scripts/tests/validate-release-version.mjs",
    "test:community": "node ./scripts/tests/validate-community-files.mjs",
    "test:links": "node ./scripts/tests/validate-markdown-links.mjs",
    "test:phase5:metadata": "npm run test:repository-licenses && npm run test:community && npm run test:links && npm run test:version",
    "test:phase5": "npm run test:phase5:metadata && npm run test:phase4",
    "scan:history:private": "node ./scripts/compliance/run-private-history-security-scan.mjs",
    "scan:actions-logs:private": "node ./scripts/compliance/run-private-actions-log-security-scan.mjs",
    "test:history-security-summary": "node ./scripts/compliance/validate-original-private-history-security-scan.mjs",
    "audit:phase6:github": "node ./scripts/tests/validate-phase6-github-repository.mjs",
    "audit:phase6:github:clean": "node ./scripts/tests/validate-phase6-github-repository.mjs --require-clean",
    "test:phase6:github-audit-logic": "node ./scripts/tests/validate-phase6-github-repository.mjs --self-test",
    "candidate:freeze": "node ./scripts/compliance/prepare-public-candidate.mjs freeze",
    "candidate:materialize": "node ./scripts/compliance/prepare-public-candidate.mjs materialize",
    "candidate:verify": "node ./scripts/compliance/prepare-public-candidate.mjs verify",
    "test:public-candidate": "node ./scripts/tests/validate-public-candidate.mjs",
    "test:phase6:metadata": "npm run test:phase5:metadata && npm run test:history-security-summary && npm run test:public-candidate && npm run test:phase6:github-audit-logic",
    "test:phase6": "npm run test:phase6:metadata && npm run test:phase1 && npm run test:workflows && npm run sbom:check",
    "init:project:dry-run": "node ./scripts/template/plan-new-project.mjs",
    "init:project": "node ./scripts/template/init-new-project.mjs",
    "project:sync": "node ./scripts/template/init-new-project.mjs --config gcss.project.json --write --allow-dirty",
    "project:scan": "node ./scripts/template/validate-project-readiness.mjs",
    "project:env": "node ./scripts/template/export-project-env.mjs",
    "template:scan": "node ./scripts/template/validate-template-placeholders.mjs",
    "framework:audit": "npm run test:capability-claims && npm run test:skill && npm run test:project-config && npm run test:init && npm run test:profiles && npm run test:workflows && npm run test:static-checks",
    "test:phase2": "npm run test:capability-claims && npm run test:skill && npm run test:commerce && npm run test:worker && npm run test:workflows && npm run test:roadmap-recovery",
    "test:phase3": "npm run test:project-config && npm run test:profiles && npm run test:shopify-summary && npm run test:worker && npm run test:static-checks && npm run typecheck && npm run test:fixtures",
    "roadmap:backup:sanity:plan": "node ./scripts/backup-sanity/plan.mjs",
    "roadmap:backup:shopify:plan": "node ./scripts/backup-shopify/plan.mjs",
    "roadmap:restore:check:plan": "node ./scripts/restore-check/plan.mjs",
    "sanity:migrate:product-pages": "node ./scripts/migrations/write-product-pages-to-sanity.mjs",
    "sanity:migrate:product-pages:write": "npm --workspace gcss-studio exec sanity -- exec ../../scripts/migrations/write-product-pages-to-sanity.mjs --with-user-token -- --env-file ../../.env --write --use-cli-client",
    "sanity:migrate:page-content-model": "node ./scripts/migrations/consolidate-page-content-model.mjs",
    "sanity:migrate:page-content-model:write": "npm --workspace gcss-studio exec sanity -- exec ../../scripts/migrations/consolidate-page-content-model.mjs --with-user-token -- --env-file ../../.env --write --use-cli-client",
    "sanity:migrate:home-product-spotlight": "node ./scripts/migrations/split-home-product-spotlight.mjs",
    "sanity:migrate:home-product-spotlight:write": "npm --workspace gcss-studio exec sanity -- exec ../../scripts/migrations/split-home-product-spotlight.mjs --with-user-token -- --env-file ../../.env --write --use-cli-client",
    "sanity:migrate:home-hero-caption": "node ./scripts/migrations/write-home-hero-caption.mjs",
    "sanity:migrate:home-hero-caption:write": "npm --workspace gcss-studio exec sanity -- exec ../../scripts/migrations/write-home-hero-caption.mjs --with-user-token -- --env-file ../../.env --write --use-cli-client",
    "sanity:migrate:image-source-defaults": "node ./scripts/migrations/set-image-source-defaults.mjs",
    "sanity:migrate:image-source-defaults:write": "npm --workspace gcss-studio exec sanity -- exec ../../scripts/migrations/set-image-source-defaults.mjs --with-user-token -- --env-file ../../.env --write --use-cli-client",
    "sanity:cleanup:legacy-content-fields": "node ./scripts/migrations/cleanup-legacy-content-fields.mjs",
    "sanity:cleanup:legacy-content-fields:write": "npm --workspace gcss-studio exec sanity -- exec ../../scripts/migrations/cleanup-legacy-content-fields.mjs --with-user-token -- --env-file ../../.env --write --use-cli-client",
    "sanity:cleanup:product-page-locales": "npm --workspace gcss-studio exec sanity -- exec ../../scripts/migrations/cleanup-product-page-locales.mjs --with-user-token -- --env-file ../../.env --use-cli-client",
    "sanity:cleanup:product-page-locales:write": "npm --workspace gcss-studio exec sanity -- exec ../../scripts/migrations/cleanup-product-page-locales.mjs --with-user-token -- --env-file ../../.env --write --use-cli-client",
    "sanity:cleanup:product-detail-hero": "node ./scripts/migrations/cleanup-product-detail-hero-fields.mjs",
    "sanity:cleanup:product-detail-hero:write": "npm --workspace gcss-studio exec sanity -- exec ../../scripts/migrations/cleanup-product-detail-hero-fields.mjs --with-user-token -- --env-file ../../.env --write --use-cli-client",
    "product:copy-content": "node ./scripts/products/copy-product-content.mjs",
    "product:copy-content:write": "npm --workspace gcss-studio exec sanity -- exec ../../scripts/products/copy-product-content.mjs --with-user-token -- --env-file ../../.env --write --use-cli-client",
    "product:create:draft": "node ./scripts/products/create-product-draft.mjs",
    "product:create:draft:write": "npm --workspace gcss-studio exec sanity -- exec ../../scripts/products/create-product-draft.mjs --with-user-token -- --env-file ../../.env --write --use-cli-client",
    "product:launch-status": "node ./scripts/products/set-product-launch-status.mjs",
    "product:launch-status:write": "npm --workspace gcss-studio exec sanity -- exec ../../scripts/products/set-product-launch-status.mjs --with-user-token -- --env-file ../../.env --write --use-cli-client",
    "shopify:summary:preview": "node ./scripts/shopify/preview-product-entry-summary.mjs",
    "shopify:summary:sync": "npm --workspace gcss-studio exec sanity -- exec ../../scripts/shopify/preview-product-entry-summary.mjs --with-user-token -- --env-file ../../.env --write --use-cli-client",
    "astro": "npm --workspace gcss-storefront run astro",
    "optimize:brand-assets": "npm --workspace gcss-storefront run optimize:brand-assets",
    "optimize:brand-video": "npm --workspace gcss-storefront run optimize:brand-video"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "ajv": "^8.20.0"
  },
  "overrides": {
    "@module-federation/dts-plugin@2.8.1": {
      "undici": "7.29.0"
    },
    "@vercel/frameworks@3.29.0": {
      "js-yaml": "3.15.1"
    }
  }
}
